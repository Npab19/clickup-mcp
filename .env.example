# --- ClickUp OAuth app -------------------------------------------------------
# Create at https://app.clickup.com/settings/apps
# The app's redirect URL must be exactly {SERVER_URL}/clickup-callback
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=

# --- Public URL --------------------------------------------------------------
# Must be HTTPS (http://localhost is allowed for local dev only). This is the
# hostname your Cloudflare Tunnel routes to clickup-mcp:8000.
SERVER_URL=https://clickup-mcp.example.com

# --- Token encryption --------------------------------------------------------
# ClickUp access tokens never expire, so the store is encrypted at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Storage -----------------------------------------------------------------
CLICKUP_DB_PATH=/data/clickup.db

# --- Tool surface ------------------------------------------------------------
# core = Phases 1-2 (~50 tools, recommended default)
# full = every tool, including the v3 Docs/Chat and admin surface
CLICKUP_TOOL_PROFILE=core

# Destructive operations (delete task/list/folder/space/goal/view/webhook,
# remove user from workspace). Deletes CASCADE in ClickUp. Off by default.
CLICKUP_ENABLE_DESTRUCTIVE=false

# Comma-separated ClickUp account emails allowed the Phase 4 admin surface.
CLICKUP_ADMIN_EMAILS=

# --- Per-identity rate limiting ----------------------------------------------
# Protects the workspace from runaway loops. Separate from ClickUp's own
# per-token ceiling (100/min on Free/Unlimited/Business).
CLICKUP_RATE_CAPACITY=60
CLICKUP_RATE_REFILL_PER_MINUTE=60

# --- Cloudflare Tunnel -------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=
